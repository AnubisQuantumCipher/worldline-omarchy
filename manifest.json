{
  "schemaVersion": 1,
  "id": "khephri.worldline",
  "name": "WORLDLINE",
  "version": "1.2.1",
  "author": "Khephri Labs",
  "license": "MIT",
  "description": "Mission control for WORLDLINE: propose isolated worlds, run and compare agents, inspect evidence, review and commit one prepared transaction, recover safely.",
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "WorldlineService.qml",
    "overlay": "Multiverse.qml",
    "barWidget": "WorldlineBar.qml"
  },
  "barWidget": {
    "displayName": "WORLDLINE",
    "description": "Current reality, agent, delta, evidence state, running jobs, and the multiverse entry point.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "motionEnabled": true,
      "worldTintEnabled": true
    },
    "schema": [
      {
        "key": "motionEnabled",
        "type": "boolean",
        "label": "Motion (collapse animation, running pulse)",
        "defaultValue": true
      },
      {
        "key": "worldTintEnabled",
        "type": "boolean",
        "label": "Alternate-world tint",
        "defaultValue": true
      }
    ]
  }
}
